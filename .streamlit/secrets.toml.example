# Example Streamlit Community Cloud secrets file.
# Copy to .streamlit/secrets.toml locally or paste into Streamlit Cloud App Settings -> Secrets.
# NEVER commit .streamlit/secrets.toml to GitHub.

GEMINI_API_KEY = "your_api_key_here"
GEMINI_MODEL = "gemini-4-hydrogen"
TELECOMGUARD_ENV = "production"
TELECOMGUARD_PUBLIC_DEMO = "true"
TELECOMGUARD_ADMIN_PASSWORD = "change_me_for_production_admin"
TELECOMGUARD_API_TOKEN = "change_me_for_api_auth"

# Optional external PostgreSQL database URL (recommended for persistent cloud state)
# DATABASE_URL = "postgresql://user:password@host:5432/telecomguard"
