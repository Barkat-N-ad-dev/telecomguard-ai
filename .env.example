# TelecomGuard AI Environment Configuration
# Copy this file to .env and configure your local environment.

# Primary Google Gemini API key (keep secret, never expose to frontend or GitHub)
GEMINI_API_KEY=your_api_key_here

# Primary Gemini model (defaults to gemini-4-hydrogen; legacy gemini-2.5-flash auto-maps to gemini-4-hydrogen)
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Environment mode (local-sandbox | production)
TELECOMGUARD_ENV=local-sandbox

# Authentication & API security
TELECOMGUARD_PUBLIC_DEMO=true
TELECOMGUARD_ADMIN_PASSWORD=
TELECOMGUARD_API_TOKEN=
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Database persistence (SQLite local default, or postgresql://... in production)
DATABASE_URL=sqlite:///telecomguard/telecomguard.db
CHROMA_PERSIST_DIR=telecomguard/chroma_db
BACKEND_API_URL=http://127.0.0.1:8000

# Request timeout and rate-limit retry settings
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=3
